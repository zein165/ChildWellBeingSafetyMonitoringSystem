// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  CHILD
}

model User {
  id        String   @id
  username  String   @unique
  password  String
  role      UserRole

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChildRelation {
  id        String   @id
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
}

enum ApplicationStatus {
    INSTALLED
    REMOVED
}

model Application {
    id          String  @id
    childId     String
    packageName String
    name        String
    versionName String
    versionCode Int
    status      ApplicationStatus
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    child  User @relation(fields: [childId], references: [id])

    @@unique([childId, packageName])
    @@index([childId])
}